<?xml version="1.0" ?>
<!-- AUTO-GENERATED by gazebo/control pc/generate_robot_description.m (do not hand-edit).
     DH rows (Tabell 2): d=[L1,0,0,L4,L5,L6] a=[0,L2,L3,0,0,0]
     alpha=[pi/2,0,0,-pi/2,pi/2,0], L=[0.3,0.8,0.6,0.3,0.35,0.3] m (Tabell 4).
     Joint k origin = C_{k-1}=Tz(d)Tx(a)Rx(alpha); joint_1 origin=identity;
     tool0 fixed origin = C6*Tz(0.1): TCP = frame6 + 0.1 m along z6 (report eq.2).
     Commanded joint values are the table theta VALUES, +/-pi/2 offsets included.
     Link visuals are placeholder spheres; tool0 is a PowerPick 10 primitive assembly
     (report Sec.2.1: ~1 kg vacuum gripper); camera.urdf.xacro adds the D435 over the conveyor.
-->
<robot name="palletizer_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find palletizer_robot)/urdf/inertial_macros.urdf.xacro"/>
  <xacro:include filename="$(find palletizer_robot)/urdf/materials.urdf.xacro"/>
  <xacro:include filename="$(find palletizer_robot)/urdf/robot_control.gazebo.xacro"/>
  <xacro:include filename="$(find palletizer_robot)/urdf/camera.urdf.xacro"/>

  <!-- Tabell 4 link lengths (edit values above in the generator, re-run to update) -->
  <link name="base_footprint"/>

  <!-- base_link frame == DH frame {0}; spawn with -z 0 so world frame == their figures. -->
  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-0 0 -0"/>
    <parent link="base_footprint"/><child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual><origin xyz="0 0 -0.08" rpy="0 0 0"/><geometry><box size="0.25 0.25 0.16"/></geometry><material name="silver"/></visual>
    <collision><origin xyz="0 0 -0.08" rpy="0 0 0"/><geometry><box size="0.25 0.25 0.16"/></geometry></collision>
    <xacro:inertial_box length="0.25" width="0.25" height="0.16" density="${7800/40}"><origin xyz="0 0 -0.08" rpy="0 0 0"/></xacro:inertial_box>
  </link>

  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0" rpy="-0 0 -0"/>
    <parent link="base_link"/><child link="link_1_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="3.14" lower="-${pi}" upper="${pi}"/>
    <dynamics damping="0.7" friction="1.0"/>
  </joint>

  <link name="link_1_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:inertial_sphere radius="0.05" density="${7800/40}"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_sphere>
  </link>

  <joint name="joint_2" type="revolute">
    <origin xyz="0 0 0.3" rpy="1.5708 0 -0"/>
    <parent link="link_1_link"/><child link="link_2_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="3.14" lower="-${pi}" upper="${pi}"/>
    <dynamics damping="0.7" friction="1.0"/>
  </joint>

  <link name="link_2_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:inertial_sphere radius="0.05" density="${7800/40}"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_sphere>
  </link>

  <joint name="joint_3" type="revolute">
    <origin xyz="0.8 0 0" rpy="0 0 -0"/>
    <parent link="link_2_link"/><child link="link_3_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="3.14" lower="-${pi}" upper="${pi}"/>
    <dynamics damping="0.7" friction="1.0"/>
  </joint>

  <link name="link_3_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:inertial_sphere radius="0.05" density="${7800/40}"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_sphere>
  </link>

  <joint name="joint_4" type="revolute">
    <origin xyz="0.6 0 0" rpy="0 0 -0"/>
    <parent link="link_3_link"/><child link="link_4_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="3.14" lower="-${pi}" upper="${pi}"/>
    <dynamics damping="0.7" friction="1.0"/>
  </joint>

  <link name="link_4_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:inertial_sphere radius="0.05" density="${7800/40}"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_sphere>
  </link>

  <joint name="joint_5" type="revolute">
    <origin xyz="0 0 0.3" rpy="-1.5708 0 -0"/>
    <parent link="link_4_link"/><child link="link_5_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="3.14" lower="-${pi}" upper="${pi}"/>
    <dynamics damping="0.7" friction="1.0"/>
  </joint>

  <link name="link_5_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:inertial_sphere radius="0.05" density="${7800/40}"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_sphere>
  </link>

  <joint name="joint_6" type="revolute">
    <origin xyz="0 0 0.35" rpy="1.5708 0 -0"/>
    <parent link="link_5_link"/><child link="link_6_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="3.14" lower="-${pi}" upper="${pi}"/>
    <dynamics damping="0.7" friction="1.0"/>
  </joint>

  <link name="link_6_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:inertial_sphere radius="0.05" density="${7800/40}"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_sphere>
  </link>

  <joint name="tool0_joint" type="fixed">
    <origin xyz="0 0 0.4" rpy="-0 0 -0"/>
    <parent link="link_6_link"/><child link="tool0"/><!-- TCP frame (eq.2) -->
  </joint>

  <link name="tool0"><!-- PowerPick 10 vacuum gripper (report Sec.2.1: ~1 kg); the
    origin IS the TCP (eq.2), cup lip plane == z=0 so pickup poses graze box tops.
    Kit parts as primitives: mount flange + extension body, 2 suction-cup brackets
    with 4 G1/4 cups at 150 mm c/c. Mass = PowerPick tooling mass 1.0 kg. -->
    <visual><origin xyz="0 0 -0.09" rpy="0 0 0"/><geometry><cylinder radius="0.027" length="0.02"/></geometry><material name="black"/></visual>
    <visual><origin xyz="0 0 -0.06" rpy="0 0 0"/><geometry><box size="0.045 0.045 0.04"/></geometry><material name="black"/></visual>
    <visual><origin xyz="0 ${-0.075} -0.03" rpy="0 0 0"/><geometry><box size="0.22 0.03 0.02"/></geometry><material name="black"/></visual>
    <visual><origin xyz="0 ${0.075} -0.03" rpy="0 0 0"/><geometry><box size="0.22 0.03 0.02"/></geometry><material name="black"/></visual>
    <visual><origin xyz="${0.06} ${-0.075} -0.015" rpy="0 0 0"/><geometry><cylinder radius="0.018" length="0.03"/></geometry><material name="green"/></visual>
    <visual><origin xyz="${-0.06} ${-0.075} -0.015" rpy="0 0 0"/><geometry><cylinder radius="0.018" length="0.03"/></geometry><material name="green"/></visual>
    <visual><origin xyz="${0.06} ${0.075} -0.015" rpy="0 0 0"/><geometry><cylinder radius="0.018" length="0.03"/></geometry><material name="green"/></visual>
    <visual><origin xyz="${-0.06} ${0.075} -0.015" rpy="0 0 0"/><geometry><cylinder radius="0.018" length="0.03"/></geometry><material name="green"/></visual>
    <collision><origin xyz="0 0 -0.05" rpy="0 0 0"/><geometry><box size="0.24 0.195 0.1"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.05" rpy="0 0 0"/><mass value="1.0"/>
      <inertia ixx="${(pow(0.1,2)+pow(0.195,2))/12}" ixy="0.0" ixz="0.0"
        iyy="${(pow(0.24,2)+pow(0.1,2))/12}" iyz="0.0" izz="${(pow(0.24,2)+pow(0.195,2))/12}"/>
    </inertial>
  </link>

  <xacro:camera_sensor parent_link="base_footprint" x="0" y="-1.25" z="1.6"
      roll="0" pitch="1.5708" yaw="0"/>

</robot>
